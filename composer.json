{
  "name":"veasin/ff-web",
  "description":"Web middleware collection for ff — CORS, CSRF, gzip, JSON, logging, rate limiter, static file serving, and auth (Basic/Token/JWT/API Key)",
  "homepage":"https://github.com/veasin/ff",
  "type":"library",
  "license":"LGPL-3.0-or-later",
  "authors":[
	{
	  "name":"Vea",
	  "email":"vea@live.cn"
	}
  ],
  "require":{
	"php":">=8.6",
    "ext-fileinfo":"*",
	"veasin/ff":">=0.5.0"
  },
  "autoload":{
	"psr-4":{
	  "ff\\web\\":"src/"
	},
	"files":[
	  "src/middleware/cors.php",
	  "src/middleware/csrf.php",
	  "src/middleware/error.php",
	  "src/middleware/gzip.php",
	  "src/middleware/json.php",
	  "src/middleware/log.php",
	  "src/middleware/rate.php",
	  "src/middleware/serve.php",
	  "src/middleware/auth/basic.php",
	  "src/middleware/auth/token.php",
	  "src/middleware/auth/jwt.php",
	  "src/middleware/auth/apikey.php",
	  "src/user.php",
	  "src/user/session.php",
	  "src/user/token.php",
	  "src/user/jwt.php",
	  "bootstrap.php"
	]
  }
}
